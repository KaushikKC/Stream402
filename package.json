{
  "name": "stream402",
  "version": "0.1.0",
  "private": true,
  "displayName": "Stream402",
  "description": "Stream402 - Monetize your content with Solana payments using the x402 protocol",
  "usecase": "Payments",
  "keywords": [
    "solana",
    "nextjs",
    "x402",
    "template",
    "starter"
  ],
  "create-solana-dapp": {
    "instructions": [
      "Install dependencies:",
      "+{pm} install",
      "Start dev server:",
      "+{pm} dev"
    ],
    "rename": {
      "project-name": {
        "to": "{{name}}",
        "paths": [
          "README.md",
          "src"
        ]
      }
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
